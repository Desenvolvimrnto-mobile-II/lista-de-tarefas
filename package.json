{
  "name": "lista-de-tarefas-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
